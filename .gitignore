# Build trees live in the workspace (../out/{left,right}), not in this repo.
# These patterns are a safety net for a stray `west build -d build-left`.
build*/
out/
__pycache__/
*.pyc

# Deck toolchain (npm / Marp). The deck is built from docs/*.md, so
# nothing here is source.
node_modules/

# Generated deck output and the concatenated intermediate doc.
docs/dist/
docs/.deck.md

# Vite dependency cache (written by `npm run dev`).
app/.vite/

# SSR smoke-test bundle (npm run smoke).
app/dist-ssr/

# Built configurator (npm run build -> npm run upload). Pure build output:
# the server holds the deployed copy, git holds the source.
app/dist/
