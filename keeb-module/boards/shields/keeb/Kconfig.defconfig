# Right half is the split peripheral.
config ZMK_SPLIT_ROLE_CENTRAL
	default n
	depends on SHIELD_KEEB_RIGHT

# Display/LVGL defaults for the nice!view panel (mirrored from ZMK's
# nice_view shield — without the 1-bit color depth settings LVGL runs
# 32bpp against the mono panel and display init hangs the kernel).
config LS0XX_VCOM_THREAD_PRIO
	default 11

config LV_Z_VDB_SIZE
	default 100

config LV_DPI_DEF
	default 161

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
	default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
	default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM if KBEEB_UI
	default ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
	select LV_FONT_MONTSERRAT_26
