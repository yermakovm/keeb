#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zephyr,display = &nice_view;
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <6>;
		/* Keymap positions run in map order; a row's line may list fewer
		 * than 12 entries (unlisted grid slots have no switch and no
		 * keymap position), and each keymap layer must carry exactly as
		 * many bindings as this map has RC() entries (ZMK_KEYMAP_LEN,
		 * see matrix.h). Global columns: left half 0-5, right half
		 * 6-11 (the right half adds col-offset 6).
		 *   rows 0-3   full alpha grid, both halves
		 *   row  4     2 extra keys per half, mirror-placed (mirror of
		 *              global col c is 11-c): LBKT left col 2 / LBRC
		 *              right col 9, RBKT left col 3 / RBRC right col 8
		 *   row  5     thumb cluster: left cols 0-3, right cols 6-9 */
		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,11) RC(0,10) RC(0,9)  RC(0,8)  RC(0,7) RC(0,6)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,11) RC(1,10) RC(1,9)  RC(1,8)  RC(1,7) RC(1,6)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,11) RC(2,10) RC(2,9)  RC(2,8)  RC(2,7) RC(2,6)
			RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,11) RC(3,10) RC(3,9)  RC(3,8)  RC(3,7) RC(3,6)
			RC(4,2) RC(4,3)   RC(4,9) RC(4,8)
			RC(5,2) RC(5,3) RC(5,4) RC(5,5)   RC(5,11) RC(5,10) RC(5,9) RC(5,8)
		>;
	};

	/* Deep-sleep-capable matrix scan (pinout: keeb-module/readme.md).
	 *
	 * ROWS are INPUTS on the nRF52840's own GPIOs (XIAO D0/D1/D2/D3/D6/D9
	 * = rows 0-5), active-high with the nRF's internal pull-downs. COLS are
	 * OUTPUTS on the MCP23017 port A (A0-A5 = driver pins 0-5), active-high.
	 * PCB diodes conduct col -> row (anode on the col side, verified on this
	 * board), so diode-direction = "col2row": during a scan the driver
	 * drives one col HIGH at a time and a pressed key pulls its row HIGH
	 * through the diode.
	 *
	 * Interrupt mode (no CONFIG_ZMK_KSCAN_MATRIX_POLLING): while idle the
	 * driver parks ALL cols driven HIGH with LEVEL_ACTIVE interrupts
	 * armed on the rows - a press pulls a row HIGH and GPIOTE fires.
	 * `wakeup-source` keeps this device out of ZMK's pre-poweroff suspend
	 * pass, so with CONFIG_ZMK_SLEEP the rows keep their PIN_CNF (SENSE)
	 * through System OFF while the expander's outputs stay latched HIGH
	 * (the Zephyr mcp23xxx driver has no PM actions, so suspend leaves it
	 * alone): any key press asserts DETECT and the SoC wakes.
	 * (History: the first all-expander config floated its inputs - the
	 * MCP23017 has no pull-downs - and spammed phantom presses; the
	 * all-on-expander polling config could never wake from deep sleep
	 * because I2C and GPIOTE are dead in System OFF.)
	 */
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;
		row-gpios =
			<&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D0 */
			<&gpio0  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D1 */
			<&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D2 */
			<&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D3 */
			<&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D6 */
			<&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  /* D9 */
		col-gpios =
			<&mcp23017_0 5 GPIO_ACTIVE_HIGH>,  /* A0 */
			<&mcp23017_0 4 GPIO_ACTIVE_HIGH>,  /* A1 */
			<&mcp23017_0 3 GPIO_ACTIVE_HIGH>,  /* A2 */
			<&mcp23017_0 2 GPIO_ACTIVE_HIGH>,  /* A3 */
			<&mcp23017_0 1 GPIO_ACTIVE_HIGH>,  /* A4 */
			<&mcp23017_0 0 GPIO_ACTIVE_HIGH>;  /* A5 */
	};

	/* Status RGB: KY-016 module (common cathode, 150R per channel already
	 * on the module) on the MCP23017's GPB5-7 (driver pins 13-15), module
	 * pin "-" to GND. VDD is LDO ~3.0V, so red (Vf ~1.8V) is bright while
	 * green/blue (Vf ~2.8V) stay dim - the state palette in zmk-status-led
	 * is red-dominant anyway (error=red, connected=green flash,
	 * advertising=blue pulse, boot=white). Both halves share this dtsi, so
	 * each half's KY-016 wires to its own expander: R -> B5, G -> B6,
	 * B -> B7. Replaces the old single LED on &gpio0 2 (P0.02, now matrix
	 * row 0). NB: the expander's outputs latch through deep sleep - the
	 * status module must drive all channels OFF before System OFF, or a
	 * lit LED stays lit until the battery dies. */
	leds {
		compatible = "gpio-leds";

		led_r: led_r {
			gpios = <&mcp23017_0 13 GPIO_ACTIVE_HIGH>;  /* B5 */
		};
		led_g: led_g {
			gpios = <&mcp23017_0 14 GPIO_ACTIVE_HIGH>;  /* B6 */
		};
		led_b: led_b {
			gpios = <&mcp23017_0 15 GPIO_ACTIVE_HIGH>;  /* B7 */
		};
	};

	status_led_device: status_led_device {
		compatible = "zmk,status-led";
		led-r = <&led_r>;
		led-g = <&led_g>;
		led-b = <&led_b>;
	};

	behaviors {
	layer_art: la {
			compatible = "keeb,layer-art";
			#binding-cells = <1>;
			display-name = "Layer Art";
		};

		/* Reboot / UF2-bootloader the RIGHT half (see
		 * behavior_remote_reset.c: combos are evaluated on the central and
		 * &sys_reset / &bootloader are source-local, so right-half keys
		 * need an explicit forward to the peripheral). */
		right_reset: right_reset {
			compatible = "keeb,remote-reset";
			target = <&sys_reset>;
			#binding-cells = <0>;
			display-name = "Right Half Reset";
		};

		right_boot: right_boot {
			compatible = "keeb,remote-reset";
			target = <&bootloader>;
			#binding-cells = <0>;
			display-name = "Right Half Bootloader";
		};
	};
};

/* Battery sense: using the board file's default divider for now
 * (xiao_ble_zmk.dts: 1M/510k, ratio ~2.96). The custom ratio previously
 * measured for this Super nRF52840 clone (~7.0: 900k top / 150k bottom,
 * same AIN7 / P0.31 tap and P0.14 active-low gate as the genuine XIAO,
 * only the resistor values differ) is left commented out below.
 *
 * The driver scales the ADC pin reading by full/output, so the ratio is
 * the only thing that matters for the SoC math. Expectation if the clone
 * divider really is ~7.0: with the default ratio a ~4.0V cell computes as
 * ~1.4-1.7V and the lithium SoC curve reads 0%. If the readout instead
 * lands on a sane voltage, the clone's divider is closer to 2.96 and the
 * default is correct. See config/keeb.conf "Battery monitoring".
 */
/* &vbatt {
 *	output-ohms = <150000>;
 *	full-ohms = <1050000>;
 * }; */

&uart0 {
       status = "disabled";
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

mcp23017_0: gpio@20 {
		compatible = "microchip,mcp23017";
		reg = <0x20>;
		status = "okay";
		gpio-controller;
		#gpio-cells = <2>;
	};
};

/* Force BOTH nRF52840 regulator stages to LDO mode.
 *
 * The Super nRF52840 clone boards are missing the external DCDC
 * inductors (likely 0R/omitted), so DC/DC mode does not regulate at
 * all: the stage passes VDDH straight through to VDD. Measured: VDD
 * (and every GPIO high) rides at battery voltage ~4V - above the
 * nRF52840 3.6V abs max, ~5V on USB (which is why the chip overheats
 * on USB) - and the radio is unstable enough that BLE split
 * connections time out at creation.
 *
 * LDO is the only mode that regulates on this hardware: VDD ~3.0V on
 * battery and USB alike. Cost: the LDO burns the VDDH-VDD drop as
 * heat (2V x ~25mA = ~50mW on USB - mild, and in-spec). */
&reg0 {
	status = "disabled"; /* VDDH stage: disabled = DCDCEN1 off = LDO */
};

&reg1 {
	regulator-initial-mode = <0>; /* core stage: LDO */
};

/* The board's spi2 pinctrl (xiao_ble-pinctrl.dtsi) claims P1.14 (XIAO D9)
 * as SPIM_MISO. The nice!view panel is write-only and D9 is matrix row 5
 * (see kscan0), so re-point spi2 at trimmed pinctrl states that stop
 * claiming MISO - otherwise every pinctrl (re-)application would steal
 * the pin back from the matrix. */
&pinctrl {
	keeb_spi2_default: spi2_default_no_miso {
		group1 {
			psels =
				<NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>;
		};
	};

	keeb_spi2_sleep: spi2_sleep_no_miso {
		group1 {
			psels =
				<NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>;
			low-power-enable;
		};
	};
};

&xiao_spi {
	status = "okay";
	pinctrl-0 = <&keeb_spi2_default>;
	pinctrl-1 = <&keeb_spi2_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
	nice_view: ls0xx@0 {
		compatible = "sharp,ls0xx";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <1000000>;
		width = <160>;
		height = <68>;
		serial-vcom-inversion;
		serial-vcom-interval = <33>;
	};
};

/*
 * Live keymap mutation engine (see keeb-module/engine, proto, keymap).
 *
 * tokens is the protocol's token table: token id = index into this list. The
 * host references a behavior by that number instead of by name, because ZMK
 * resolves a binding by device-name string and a behavior that is not compiled
 * into the image cannot be bound at runtime. Listing a behavior whose driver is
 * switched off is harmless - the engine finds the missing device at boot and
 * reports the token as unavailable.
 *
 * The list mirrors what the configurator can offer today: normal keys, the
 * layer and tap-hold behaviors, sticky/toggle/grave-escape helpers, Bluetooth
 * and output switching, reset, mouse behaviors, and the keeb nodes. Combos and
 * conditional layers are separate devicetree nodes, not bindings, so they are
 * not reachable here - they stay whatever the keymap file says.
 *
 * reserved-positions are the two outer top corners (PLUS and MINUS in the
 * keymap file). The engine refuses to rebind them over TLV, and holding both
 * for revert-hold-ms discards the saved keymap and returns to the keymap file.
 * That chord is detected on raw key positions, so no layout, and no bad or
 * missing layout, can lock the configurator out.
 */
/ {
	keeb_engine: engine {
		compatible = "keeb,engine";

		/* Behaviour tokens, named by ZMK's own devicetree labels. The
		 * node text for a behaviour is always present - the omit rule
		 * only ever marks it /omit-if-no-ref/ - and referencing it here
		 * is what keeps the behaviours we want to write to compiled in.
		 * A behaviour whose driver was dropped stays listed here; the
		 * runtime readiness check in keymap/keeb_tokens.c is what leaves
		 * it out of the list the host is offered, so a write to a
		 * behaviour this firmware cannot execute never gets an answer
		 * that looks like a valid token.
		 *
		 * Token id is the index into this list, so inserting here moves
		 * every id after it. The host resolves tokens by name hash
		 * (KEEB_T_TOKENS), which is why this list may be reordered.
		 */
		tokens = <
			&kp &trans &none
			&mo &to &tog &lt &mt
			&sk &sl &kt &gresc &key_repeat &caps_word
			&bt &out &sys_reset &bootloader
			&bl &rgb_ug
			&mmv &msc &mkp
			&hml &hmr
			&layer_art &right_reset &right_boot
		>;

		reserved-positions = <0 11>;
		revert-hold-ms = <3000>;
	};
};
