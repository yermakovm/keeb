#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/regulator/nrf5x.h>
#include <dt-bindings/zmk/matrix_transform.h>

#include <keeb-positions.dtsi>

/ {
	chosen {
		zephyr,display = &nice_view;
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
    zmk,battery = &vbatt;
	};

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "BATTERY";
    };

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <6>;
		/* Key positions are named in dts/keeb-positions.dtsi; this map is what
		 * defines those numbers, so keep the two in step - app/scripts/gen-contract.mjs
		 * checks every named group against this map, so a name that stops matching
		 * the wiring fails the build instead of silently rebinding another key.
		 *
		 * A row's line may list fewer than 12 entries: an unlisted grid slot has no
		 * switch and no keymap position. Each keymap layer must carry exactly as many
		 * bindings as this map has RC() entries (ZMK_KEYMAP_LEN, see matrix.h).
		 * Global columns: left half 0-5, right half 6-11 (keeb_right.overlay adds
		 * col-offset 6). Each half numbers its own columns 0-5 the same way, so a
		 * key's mirror on the other half is the same local column: global c on the
		 * left, c+6 on the right. Every row here obeys that - alpha 0-5, the extras
		 * 2-3, the thumb cluster 2-5, on both halves.
		 *   rows 0-3   full alpha grid, both halves
		 *   row  4     2 extra keys per half, local cols 2-3
		 *   row  5     thumb cluster, local cols 2-5
		 * Board column numbering grows toward the split on the left half and away
		 * from it on the right: left positions 0-5 map to cols 5-0 (outer key at
		 * position 0, col 5; the key next to the split, position 5, col 0), right
		 * positions 6-11 map to cols 6-11 (position 6, col 6, next to the split,
		 * position 11, col 11, outermost). The keymap drawing therefore reads
		 * left-to-right across the board: position 0 far left, 6 the right half's
		 * innermost key, 11 far right. Reversing a half's columns here mirrors that
		 * half on the board and in the configurator while keeping the mirror checks
		 * happy - the position sets stay the same, only the order of the keys
		 * changes. */
		map = <
			RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)   RC(0,6) RC(0,7) RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
			RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)   RC(1,6) RC(1,7) RC(1,8)  RC(1,9)  RC(1,10) RC(1,11)
			RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)   RC(2,6) RC(2,7) RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)
			RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)   RC(3,6) RC(3,7) RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)
			RC(4,2) RC(4,3)   RC(4,8) RC(4,9)
			RC(5,3) RC(5,2) RC(5,5) RC(5,4)   RC(5,10) RC(5,11) RC(5,8) RC(5,9)
		>;
	};

kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;
		row-gpios =
			<&gpio0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D0  */
			<&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D4  */
			<&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D5  */
			<&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D6  */
			<&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* D7  */
			<&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  /* D8  */
		col-gpios =
			<&gpio1  6 GPIO_ACTIVE_HIGH>,  /* D9  */
			<&gpio0  9 GPIO_ACTIVE_HIGH>,  /* D10 */
			<&gpio0 10 GPIO_ACTIVE_HIGH>,  /* D16 */
			<&gpio1 11 GPIO_ACTIVE_HIGH>,  /* D14 */
			<&gpio1 13 GPIO_ACTIVE_HIGH>,  /* D15 */
			<&gpio1 15 GPIO_ACTIVE_HIGH>;  /* D18 */
	};

status_leds: status_leds {
		compatible = "pwm-leds";

		led_r: led_r {
			/* instance channel, period, polarity (common cathode -> active high) */
			pwms = <&pwm1 0 PWM_USEC(2000) PWM_POLARITY_NORMAL>;  /* D19/A1 = P0.02 */
		};
		led_g: led_g {
			pwms = <&pwm1 1 PWM_USEC(2000) PWM_POLARITY_NORMAL>;  /* D20/A2 = P0.29 */
		};
		led_b: led_b {
			pwms = <&pwm1 2 PWM_USEC(2000) PWM_POLARITY_NORMAL>;  /* D21/A3 = P0.31 */
		};
	};

	status_led_device: status_led_device {
		compatible = "zmk,status-led";
		led-r = <&led_r>;
		led-g = <&led_g>;
		led-b = <&led_b>;
	};

	behaviors {
	layer_art: la {
			compatible = "keeb,layer-art";
			#binding-cells = <1>;
			display-name = "Layer Art";
		};

		/* Not a key: nothing in the keymap or in the engine's token list
		 * references it. The central invokes this behaviour so the other half
		 * applies the same idle/sleep timeouts it just applied to itself - see
		 * settings/behavior_keeb_timeouts.c. Its name is the string the split
		 * payload carries, so it stays under 16 bytes. */
		/* Neither is this one: the central invokes it once a second so the
		 * other half's panel can show what only the central knows - typing
		 * rate, active BLE profile, host link signal. param1 = words per
		 * minute, param2 = profile index | count << 8 | rssi % << 16
		 * (see ui/layer_sync.c for the packing).
		 *
		 * The node name is the string the split payload carries and that
		 * payload has room for 8 characters (ZMK_SPLIT_RUN_BEHAVIOR_DEV_LEN
		 * is 9, NUL included) - "keeb_stat" was silently truncated to
		 * "keeb_sta" and every push was refused. Keep it short. */
		uistat: uistat {
			compatible = "keeb,ui-stat";
			#binding-cells = <2>;
			display-name = "UI Stat";
		};

		keeb_tmo: keeb_tmo {
			compatible = "keeb,timeouts";
			#binding-cells = <0>;
		};

		/* Not a key either: the central invokes it to ship the other half's
		 * panel table, two 32-bit words per invocation (ui/panel_stream.h).
		 * The node name is the string the split payload carries, so keep it
		 * short - the label is allowed to be longer than the name. */
		panel_relay: panel {
			compatible = "keeb,panel";
			#binding-cells = <2>;
		};

	right_reset: right_reset {
			compatible = "keeb,remote-reset";
			target = <&sys_reset>;
			#binding-cells = <0>;
			display-name = "Right Half Reset";
		};

		right_boot: right_boot {
			compatible = "keeb,remote-reset";
			target = <&bootloader>;
			#binding-cells = <0>;
			display-name = "Right Half Bootloader";
		};

	buzzer_reset: buzzer_reset {
			compatible = "zmk,behavior-buzzer";
			target = <&sys_reset>;
			#binding-cells = <0>;
			display-name = "Buzz Then Reset";
		};

		buzzer_boot: buzzer_boot {
			compatible = "zmk,behavior-buzzer";
			target = <&bootloader>;
			tune = "bootloader";
			#binding-cells = <0>;
			display-name = "Buzz Then Bootloader";
		};
	};
};

&pinctrl {
	status_led_pwm_default: status_led_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>,   /* R  D19/A1 = P0.02 */
				<NRF_PSEL(PWM_OUT1, 0, 29)>,  /* G  D20/A2 = P0.29 */
				<NRF_PSEL(PWM_OUT2, 0, 31)>;  /* B  D21/A3 = P0.31 */
		};
	};

	status_led_pwm_sleep: status_led_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>,
				<NRF_PSEL(PWM_OUT1, 0, 29)>,
				<NRF_PSEL(PWM_OUT2, 0, 31)>;
			low-power-enable;
		};
	};
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&status_led_pwm_default>;
	pinctrl-1 = <&status_led_pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&adc {
	status = "okay";
};

&zephyr_udc0 {
	board_cdc_acm_uart: board_cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,console = &board_cdc_acm_uart;
		zephyr,shell-uart = &board_cdc_acm_uart;
	};
};

&reg0 {
	status = "disabled";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&pinctrl {
	spi0_default: spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
				<NRF_PSEL(SPIM_MOSI, 0, 17)>,
				<NRF_PSEL(SPIM_MISO, 0, 25)>;
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
				<NRF_PSEL(SPIM_MOSI, 0, 17)>,
				<NRF_PSEL(SPIM_MISO, 0, 25)>;
			low-power-enable;
		};
	};
};

nice_view_spi: &spi0 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	/* LS0xx chip select is active-high (XS: L = disabled, H = enabled),
	 * which is also what ZMK's nice_view_adapter uses. */
	cs-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;  /* D1 */

	nice_view: ls0xx@0 {
		compatible = "sharp,ls0xx";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <1000000>;
		width = <160>;
		height = <68>;
		serial-vcom-inversion;
		serial-vcom-interval = <33>;
	};
};
/ {
	keeb_engine: engine {
		compatible = "keeb,engine";
   	tokens = <
			&kp &trans &none
			&mo &to &tog &lt &mt
			&sk &sl &kt &gresc &key_repeat &caps_word
			&bt &out &sys_reset &bootloader
			&bl &rgb_ug
			&mmv &msc &mkp
			&hml &hmr
			&layer_art &right_reset &right_boot
		>;

		reserved-positions = <KEEB_POS_L_TOP_0 KEEB_POS_R_TOP_0>;
		revert-hold-ms = <3000>;
	};
};
