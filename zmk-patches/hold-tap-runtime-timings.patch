+    if ((last_tapped.timestamp + effective_prior_idle_ms(hold_tap->config)) > hold_tap->timestamp) {
         return true;
     } else {
         return (last_tapped.position == hold_tap->position) &&
-               (last_tapped.timestamp + hold_tap->config->quick_tap_ms) > hold_tap->timestamp;
+               (last_tapped.timestamp + effective_quick_tap_ms(hold_tap->config)) > hold_tap->timestamp;
     }
 }
 
