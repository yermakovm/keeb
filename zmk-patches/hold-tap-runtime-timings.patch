+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+/*
+ * Hold-tap timings retuned while the keyboard runs, by the config channel
+ * (zmk-config's keeb-module).  Every setter takes a keyboard-wide value; pass 0
+ * (or -1 for the flavour) to fall back to each hold-tap's own devicetree value.
+ *
+ * Flavour numbers follow the devicetree enum order:
+ *   0 hold-preferred, 1 balanced, 2 tap-preferred, 3 tap-unless-interrupted.
+ *
+ * Only the central half resolves hold-taps, so these are central-only settings.
+ */
+
+int zmk_hold_tap_set_tapping_term_ms(int ms);
+int zmk_hold_tap_set_quick_tap_ms(int ms);
+int zmk_hold_tap_set_prior_idle_ms(int ms);
+int zmk_hold_tap_set_flavor(int flavor);
