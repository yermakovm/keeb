     int32_t hold_trigger_key_positions[];
 };
 
+/*
+ * Keyboard-wide retuning of the hold-tap timings, written by the config channel
+ * (zmk-config's keeb-module).  Zero - or -1 for the flavour - means "use this
+ * behaviour's own devicetree value", so a build that tunes each hold-tap
+ * separately keeps its differences until a host asks for a global value.
+ */
+static int ht_tapping_term_ms;
+static int ht_quick_tap_ms;
+static int ht_prior_idle_ms;
+static int ht_flavor = -1;
+
+static int effective_tapping_term_ms(const struct behavior_hold_tap_config *cfg) {
+    return ht_tapping_term_ms ? ht_tapping_term_ms : cfg->tapping_term_ms;
+}
+
+static int effective_quick_tap_ms(const struct behavior_hold_tap_config *cfg) {
+    return ht_quick_tap_ms ? ht_quick_tap_ms : cfg->quick_tap_ms;
+}
+
+static int effective_prior_idle_ms(const struct behavior_hold_tap_config *cfg) {
+    return ht_prior_idle_ms ? ht_prior_idle_ms : cfg->require_prior_idle_ms;
+}
+
+static enum flavor effective_flavor(const struct behavior_hold_tap_config *cfg) {
+    return ht_flavor >= 0 ? (enum flavor)ht_flavor : cfg->flavor;
+}
+
+int zmk_hold_tap_set_tapping_term_ms(int ms) {
+    ht_tapping_term_ms = ms;
+    return 0;
+}
+
+int zmk_hold_tap_set_quick_tap_ms(int ms) {
+    ht_quick_tap_ms = ms;
+    return 0;
+}
+
+int zmk_hold_tap_set_prior_idle_ms(int ms) {
+    ht_prior_idle_ms = ms;
+    return 0;
+}
+
+int zmk_hold_tap_set_flavor(int flavor) {
+    if (flavor < -1 || flavor > FLAVOR_TAP_UNLESS_INTERRUPTED) {
+        return -EINVAL;
+    }
+    ht_flavor = flavor;
+    return 0;
+}
+
 struct behavior_hold_tap_data {
 #if IS_ENABLED(CONFIG_ZMK_BEHAVIOR_METADATA)
     struct behavior_parameter_metadata_set set;
@@ -141,11 +192,11 @@ static void store_last_hold_tapped(struct active_hold_tap *hold_tap) {
