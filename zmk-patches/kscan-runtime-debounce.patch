diff --git a/app/module/drivers/kscan/kscan_gpio_matrix.c b/app/module/drivers/kscan/kscan_gpio_matrix.c
index d68f1593..bd08116d 100644
--- a/app/module/drivers/kscan/kscan_gpio_matrix.c
+++ b/app/module/drivers/kscan/kscan_gpio_matrix.c
@@ -17,6 +17,7 @@
 #include <zephyr/sys/util.h>
 
 #include <zmk/debounce.h>
+#include <zmk/kscan_debounce.h>
 
 LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
@@ -83,6 +84,11 @@ struct kscan_matrix_data {
      * (config->rows * config->cols)
      */
     struct zmk_debounce_state *matrix_state;
+    /**
+     * Debounce timings in work, copied from the (read-only, flash resident)
+     * config at init so the config channel can retune them while running.
+     */
+    struct zmk_debounce_config debounce;
 };
 
 struct kscan_matrix_config {
@@ -245,7 +251,7 @@ static int kscan_matrix_read(const struct device *dev) {
             }
 
             zmk_debounce_update(&data->matrix_state[index], active, config->debounce_scan_period_ms,
-                                &config->debounce_config);
+                                &data->debounce);
         }
 
         err = gpio_pin_set_dt(&out_gpio->spec, 0);
@@ -443,10 +449,33 @@ static void kscan_matrix_setup_pins(const struct device *dev) {
     kscan_matrix_set_all_outputs(dev, 0);
 }
 
+int zmk_kscan_gpio_matrix_set_debounce_ms(const struct device *dev, uint32_t press_ms,
+                                         uint32_t release_ms) {
+    struct kscan_matrix_data *data = dev->data;
+
+    /* Two aligned stores from the config thread against the scan work reading
+     * them: at worst one scan uses one new value.  A debounce of 0 is ZMK's
+     * "eager" setting and is honoured here, unlike the timeout settings. */
+    data->debounce.debounce_press_ms = (int)press_ms;
+    data->debounce.debounce_release_ms = (int)release_ms;
+
+    return 0;
+}
+
+void zmk_kscan_gpio_matrix_get_debounce_ms(const struct device *dev, uint32_t *press_ms,
+                                          uint32_t *release_ms) {
+    const struct kscan_matrix_data *data = dev->data;
+
+    *press_ms = (uint32_t)data->debounce.debounce_press_ms;
+    *release_ms = (uint32_t)data->debounce.debounce_release_ms;
+}
+
 static int kscan_matrix_init(const struct device *dev) {
     struct kscan_matrix_data *data = dev->data;
+    const struct kscan_matrix_config *config = dev->config;
 
     data->dev = dev;
+    data->debounce = config->debounce_config;
 
     // Sort inputs by port so we can read each port just once per scan.
     kscan_gpio_list_sort_by_port(&data->inputs);
diff --git a/app/module/include/zmk/kscan_debounce.h b/app/module/include/zmk/kscan_debounce.h
new file mode 100644
index 00000000..cd63c3e9
--- /dev/null
+++ b/app/module/include/zmk/kscan_debounce.h
@@ -0,0 +1,24 @@
+/*
+ * Copyright (c) 2025 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include <zephyr/device.h>
+
+/*
+ * Matrix debounce timings changed while the keyboard runs, by the config channel
+ * (zmk-config's keeb-module).  The matrix driver keeps its flashed values in a
+ * const config struct in flash, so it debounces from a RAM copy of its own.
+ *
+ * These act on the half they are called on: each half scans its own matrix.
+ */
+
+int zmk_kscan_gpio_matrix_set_debounce_ms(const struct device *dev, uint32_t press_ms,
+                                         uint32_t release_ms);
+void zmk_kscan_gpio_matrix_get_debounce_ms(const struct device *dev, uint32_t *press_ms,
+                                          uint32_t *release_ms);
