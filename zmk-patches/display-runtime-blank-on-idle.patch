+bool zmk_display_get_blank_on_idle(void) { return blank_on_idle; }
+
+void zmk_display_set_blank_on_idle(bool enabled) {
+    blank_on_idle = enabled;
+
+    /* Turning it off while the screen is already blank: bring it back now instead
+     * of waiting for the next key press.  Turning it on takes effect at the next
+     * IDLE, the only moment it can act. */
+    if (!enabled && zmk_display_is_initialized()) {
+        start_display_updates();
+    }
